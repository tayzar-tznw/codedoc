# ============================================================
# CodeDoc Configuration
# Copy this file to .env at the repo root and fill in your values.
# This is the SINGLE .env for every module — each package loads it
# through its config.py (graph_generator/config.py,
# graph_query_agent/config.py, webapp/config.py, mcp_server/config.py).
# ============================================================

# --- Required: Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Gemini ---
GEMINI_MODEL=gemini-3.7-flash
GEMINI_CONCURRENCY=100
# MAX_OUTPUT_TOKENS=8192

# --- Spanner Graph ---
SPANNER_INSTANCE=codedoc
SPANNER_DATABASE=codedoc-java
GRAPH_NAME=code_graph_a
# ID_PREFIX=a

# --- Java LSP (Phase 1.6 セマンティック解決) ---
# Eclipse JDT Language Server (jdtls) によるシンボル厳密解決。無効化するとノードのみ生成され
# 呼び出し/継承エッジは生成されません(名前推測による誤エッジ防止)。
JAVA_LSP_ENABLED=true
# jdtls 起動スクリプト。PATH に無い場合は絶対パスで指定(例: /home/<user>/tools/jdt-language-server/bin/jdtls。~ は展開されません)
JAVA_LSP_CMD=jdtls
# 同時に起動する jdtls セッション数(Maven プロジェクトルート単位)
JAVA_LSP_CONCURRENCY=4
# プロジェクトのロード完了を待つ上限(秒)
JAVA_LSP_TIMEOUT_S=300
# 任意: m2e に渡す settings.xml(隔離ローカルリポジトリを使う場合)。未設定なら ~/.m2 既定
# JAVA_LSP_MAVEN_SETTINGS=/path/to/settings.xml
# 任意: jdtls 実行用 JDK 21 の場所(既定 /usr/lib/jvm/java-21-openjdk-amd64)
# JAVA21_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# --- Output ---
OUTPUT_DIR=output_docs_pipeline
EMBED_CONCURRENCY=20

# --- Servers (webapp / MCP) ---
# HOST=0.0.0.0
# PORT=8080

# Fix SSL mTLS on GCE
GCE_METADATA_MTLS_MODE=none
