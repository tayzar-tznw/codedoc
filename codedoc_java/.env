# ============================================================
# CodeDoc Configuration — the single .env for every module.
# All packages load this file via their config.py.
# ============================================================

# --- Google Cloud ---

GOOGLE_CLOUD_PROJECT=development-459201
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Gemini ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONCURRENCY=100

# --- Spanner Graph ---
SPANNER_INSTANCE=codedoc
SPANNER_DATABASE=codedoc-java
GRAPH_NAME=code_graph_a

# --- Java LSP (Phase 1.6 セマンティック解決) ---
JAVA_LSP_ENABLED=true
JAVA_LSP_CMD=/home/admin/tools/jdt-language-server/bin/jdtls
JAVA_LSP_CONCURRENCY=4
JAVA_LSP_TIMEOUT_S=300

# --- Output ---
OUTPUT_DIR=output_docs_pipeline
EMBED_CONCURRENCY=20

# Fix SSL mTLS on GCE
GCE_METADATA_MTLS_MODE=none
