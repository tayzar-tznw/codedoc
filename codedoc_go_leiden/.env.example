# ============================================================
# CodeDoc (Go, Leiden topics) Configuration [LEIDEN-HOOK]
# Copy this file to .env and fill in your values
# ============================================================

# --- Google Cloud ---
# Project for Gemini, embeddings and Spanner. Unset = the ADC / gcloud default
# project (gcloud config get-value project); the commands and the agent print
# the project they use.
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_GENAI_USE_VERTEXAI=true
# Vertex AI location (Gemini + embeddings)
GOOGLE_CLOUD_LOCATION=global

# --- Gemini ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CONCURRENCY=100
# Output token cap per request; Gemini-3 thinking shares this budget,
# so too low yields empty responses — keep it generous
MAX_OUTPUT_TOKENS=8192

# --- Spanner Graph ---
SPANNER_INSTANCE=codedoc-instance
# LEIDEN-HOOK: codedoc_go_leiden's own database
SPANNER_DATABASE=codedoc-go-leiden
# GRAPH_NAME + ID_PREFIX allow side-by-side graphs in one database
GRAPH_NAME=code_graph_a
ID_PREFIX=a

# --- Output ---
OUTPUT_DIR=output_docs_pipeline
EMBED_CONCURRENCY=20

# --- Go toolchain and build configuration ---
# Path to a go binary. Unset: .tools/go/bin/go after `setup go`, else go on PATH
# GO_TOOLCHAIN=/abs/path/to/go/bin/go
GO_BUILD_GOOS=linux
GO_BUILD_GOARCH=amd64
# Comma-separated build tags
GO_BUILD_TAGS=
# 1 = let the go command run gcc and pkg-config (cgo)
GO_BUILD_CGO=0
# Extra configurations for files the primary build excludes:
# goos/goarch[+tag+tag] entries separated by spaces
GO_EXTRA_BUILDS=
# Seconds per helper run
GO_HELPER_TIMEOUT=1800
# Interface candidates and ambiguous targets become PossiblyCalls edges only
# when the candidate count stays at or below this cap
POSSIBLY_CALLS_MAX_CANDIDATES=5

# --- Module sources ---
# 1 = download the modules a load needs into OUTPUT_DIR/go/modcache
# (same as --download-modules); 0 = offline
GO_MODULES_DOWNLOAD=0
# Module proxy for download mode only (no ",direct")
GO_PROXY=https://proxy.golang.org
# Checksum database: download mode only; off disables checksum DB lookups
GO_SUMDB=sum.golang.org
# User module cache read offline (never written). Unset: go env GOMODCACHE
# GO_USER_MODCACHE=/abs/path/to/go/pkg/mod

# --- Wiki track ---
# Above either limit, Phase 2 summarizes a file node by node
WIKI_FILE_MAX_CHARS=40000
WIKI_FILE_MAX_NODES=40
# 1 = summarize generated files with Gemini; 0 = doc comment plus a fixed note
WIKI_SUMMARIZE_GENERATED=0
# Summary cache shared by codedoc_go and codedoc_go_leiden. Unset:
# OUTPUT_DIR/repos/<repo>/summaries
# WIKI_SUMMARY_CACHE=/abs/path/to/summary-cache

# --- Leiden topics --- [LEIDEN-HOOK]
# Level-1 topic count band of the resolution sweep
TOPIC_MIN=5
TOPIC_MAX=25
# A level-1 topic with more primary atoms is split into subtopics
SUBTOPIC_MIN_ATOMS=12
# strict, or a + combination of degree_norm, calls_only, no_implements, with_tests
TOPIC_PROFILE=strict
# Leiden seeds, comma-separated
TOPIC_SEEDS=42,43,44,45,46

# --- Peers ---
# Peer repos as [name=]path, separated by ":" (os.pathsep)
# PEER_REPOS=shared=/abs/path/to/shared

# Fix SSL mTLS on GCE
GCE_METADATA_MTLS_MODE=none
